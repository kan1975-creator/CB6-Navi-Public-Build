+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import javax.net.ssl.HttpsURLConnection;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+public final class AiSearch implements AutoCloseable {
+  public interface Callback {
+    void finish(List<Cb6SearchEngine.Result> rows, String expandedCategory, String status);
+  }
+
+  private enum Stage {
+    ACCOUNT("AI-01 契約照会"), FREE("AI-02 無料確認不能"),
+    CLASSIFY("AI-03 AI分類通信"), PARSE("AI-04 分類応答解析"),
+    OVERPASS("AI-05 Overpass通信"), QUOTA("AI-06 無料枠到達");
+
+    final String label;
+    Stage(String label) { this.label = label; }
+  }
+
+  private static final class Diagnostic {
+    Stage stage = Stage.ACCOUNT;
+    int http = -1;
+
+    void begin(Stage next) {
+      stage = next;
+      http = -1;
+    }
+
+    String message() {
+      return stage.label + (http >= 100 && http <= 599 ? " (HTTP " + http + ")" : "")
+          + "。端末内検索を表示します";
+    }
+  }
+
+  private final AiPreferences settings;
+  private final android.net.ConnectivityManager network;
+
+  public boolean onlineAvailable() {
+    if (!settings.prefs.contains("credentials") || settings.quotaBlocked() || network == null) return false;
+    android.net.NetworkInfo state = network.getActiveNetworkInfo();
+    return state != null && state.isConnected();
+  }
+  private final ExecutorService worker = Executors.newSingleThreadExecutor();
+  private final Handler main = new Handler(Looper.getMainLooper());
+  private long generation;
+  private Future<?> pending;
+  private HttpsURLConnection active;
+
+  public AiSearch(Context context) { settings = new AiPreferences(context);
+    network = (android.net.ConnectivityManager) context.getSystemService(Context.CONNECTIVITY_SERVICE); }
+
+  public static String localTerm(String query) { return new AiIntent(query).term; }
+
+  public static Location recent(Location fix) {
+    if (fix == null) return null;
+    long age = SystemClock.elapsedRealtimeNanos() - fix.getElapsedRealtimeNanos();
+    return age >= 0 && age <= 300_000_000_000L && Double.isFinite(fix.getLatitude())
+        && Double.isFinite(fix.getLongitude()) ? new Location(fix) : null;
+  }
+
+  public void configure(Context context) {
+    LinearLayout form = new LinearLayout(context);
+    form.setOrientation(LinearLayout.VERTICAL);
+    EditText account = new EditText(context);
+    account.setSingleLine();
+    account.setHint("Cloudflare Account ID");
+    EditText token = new EditText(context);
+    token.setSingleLine();
+    token.setSaveEnabled(false);
+    if (android.os.Build.VERSION.SDK_INT >= 26) token.setImportantForAutofill(android.view.View.IMPORTANT_FOR_AUTOFILL_NO_EXCLUDE_DESCENDANTS);
+    token.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_PASSWORD);
+    token.setHint("APIトークン");
+    form.addView(account);
+    form.addView(token);
+    new AlertDialog.Builder(context).setTitle("AI検索の設定")
+        .setMessage("無料専用アカウントを使用します。Workers AIの実行権限と契約の読取権限が必要です。")
+        .setView(form).setNegativeButton("閉じる", null)
+        .setNeutralButton("登録を解除", (d,w) -> settings.prefs.edit().remove("credentials").apply())
+        .setPositiveButton("暗号化して保存", (d,w) -> {
+          try {
+            settings.save(account.getText().toString().trim(), token.getText().toString().trim());
+            Toast.makeText(context, "保存しました", Toast.LENGTH_SHORT).show();
+          } catch (Exception e) {
+            Toast.makeText(context, "入力内容または端末の鍵を確認してください", Toast.LENGTH_LONG).show();
+          } finally { token.setText(""); }
+        }).show();
+  }
+
+  public synchronized void cancel() {
+    ++generation;
+    if (pending != null) pending.cancel(true);
+    if (active != null) active.disconnect();
+    active = null;
+  }
+
+  @Override public void close() {
+    cancel();
+    worker.shutdownNow();
+  }
+
+  private synchronized void check(long ticket) throws IOException {
+    if (ticket != generation || Thread.currentThread().isInterrupted()) throw new IOException();
+  }
+
+  public synchronized void start(String query, Location fix, Callback callback) {
+    cancel();
+    long ticket = generation;
+    pending = worker.submit(() -> {
+      List<Cb6SearchEngine.Result> rows = Collections.emptyList();
+      Diagnostic diagnostic = new Diagnostic();
+      String status;
+      String expansion = "";
+      try {
+        check(ticket);
+        if (!onlineAvailable()) {
+          if (settings.quotaBlocked()) diagnostic.stage = Stage.QUOTA;
+          status = diagnostic.stage == Stage.QUOTA ? diagnostic.message() : "端末内検索を表示します";
+        } else {
+          AiIntent intent = new AiIntent(query);
+          int category = intent.category;
+          JSONObject credentials = settings.credentials();
+          String base = "https://api.cloudflare.com/client/v4/accounts/" + credentials.getString("account");
+          String token = credentials.getString("token");
+          requireFreeAccount(diagnostic, ticket, base, token);
+          diagnostic.begin(Stage.CLASSIFY);
+          int suggested = classify(diagnostic, ticket, base, token, query);
+          if (category < 0 && suggested >= 0) {
+            category = suggested;
+            expansion = AiIntent.TYPES[suggested][0];
+          }
+          if (fix == null) status = "Gemma 4・現在地未取得。端末内検索を表示します";
+          else {
+            diagnostic.begin(Stage.OVERPASS);
+            rows = nearby(diagnostic, ticket, intent, category, fix);
+            status = "Gemma 4・周辺のOSM候補 " + rows.size() + "件";
+          }
+        }
+      } catch (Exception e) {
+        expansion = "";
+        status = diagnostic.message();
+      }
+      List<Cb6SearchEngine.Result> delivered = rows;
+      String message = status;
+      String categoryTerm = expansion;
+      main.post(() -> {
+        synchronized (this) { if (generation != ticket) return; }
+        callback.finish(delivered, categoryTerm, message);
+      });
+    });
+  }
+
+  private void requireFreeAccount(Diagnostic diagnostic, long ticket, String base, String token) throws Exception {
+    JSONObject subscriptions = request(diagnostic, ticket, base + "/subscriptions", token, null, null);
+    if (!Boolean.TRUE.equals(subscriptions.opt("success"))) throw new IOException();
+    diagnostic.stage = Stage.FREE;
+    JSONArray entries = subscriptions.getJSONArray("result");
+    if (entries.length() == 0) throw new IOException();
+    for (int i = 0; i < entries.length(); i++) {
+      JSONObject sub = entries.getJSONObject(i);
+      JSONObject plan = sub.getJSONObject("rate_plan");
+      Object price = sub.opt("price");
+      if (!"free".equals(plan.opt("id"))
+          || !"Workers Free".equalsIgnoreCase(plan.optString("public_name"))
+          || !"Provisioned".equals(sub.opt("state"))
+          || !(price instanceof Number) || new java.math.BigDecimal(price.toString()).signum() != 0)
+        throw new IOException();
+    }
+    if (subscriptions.has("result_info")) {
+      JSONObject page = subscriptions.getJSONObject("result_info");
+      if (!pageValue(page, "total_count", entries.length()) || !pageValue(page, "total_pages", 1)
+          || !pageValue(page, "page", 1) || !pageValue(page, "count", entries.length())
+          || (!page.has("total_count") && !page.has("total_pages")))
+        throw new IOException();
+    }
+  }
+
+  private static boolean pageValue(JSONObject page, String key, int expected) {
+    if (!page.has(key)) return true;
+    Object value = page.opt(key);
+    return value instanceof Number && Integer.toString(expected).equals(value.toString());
+  }
+
+  private int classify(Diagnostic diagnostic, long ticket, String base, String token, String query) throws Exception {
+    StringBuilder instruction = new StringBuilder("検索の施設分類番号だけを半角数字で返す。不明は -1。");
+    for (int i = 0; i < AiIntent.TYPES.length; i++)
+      instruction.append(i).append('=').append(AiIntent.TYPES[i][0]).append(' ');
+    JSONArray messages = new JSONArray()
+        .put(new JSONObject().put("role","system").put("content", instruction.toString()))
+        .put(new JSONObject().put("role","user").put("content",query));
+    JSONObject input = new JSONObject().put("messages",messages).put("max_tokens",128).put("temperature",0);
+    JSONObject response = request(diagnostic, ticket, base + "/ai/run/@cf/google/gemma-4-26b-a4b-it",
+        token, "application/json", input.toString());
+    if (!response.getBoolean("success")) throw new IOException();
+    JSONObject result = response.getJSONObject("result");
+    String value = result.has("choices")
+        ? result.getJSONArray("choices").getJSONObject(0).getJSONObject("message").getString("content").trim()
+        : result.getString("response").trim();
+    if ("-1".equals(value)) return -1;
+    if (!value.matches("[0-8]")) throw new IOException();
+    return Integer.parseInt(value);
+  }
+
+  private List<Cb6SearchEngine.Result> nearby(Diagnostic diagnostic, long ticket, AiIntent intent, int type, Location fix) throws Exception {
+    String selector = type < 0 ? "[\"name\"=" + JSONObject.quote(intent.term) + "]"
+        : "[" + AiIntent.TYPES[type][1] + "=" + AiIntent.TYPES[type][2] + "][name]";
+    String q = String.format(Locale.ROOT, "[out:json][timeout:8];nwr%s(around:%d,%.6f,%.6f);out center 60;",
+        selector, intent.radius, fix.getLatitude(), fix.getLongitude());
+    JSONObject data = request(diagnostic, ticket, "https://overpass-api.de/api/interpreter", null,
+        "application/x-www-form-urlencoded", "data=" + URLEncoder.encode(q, "UTF-8"));
+    if (data.has("remark")) throw new IOException();
+    JSONArray elements = data.getJSONArray("elements");
+    List<Cb6SearchEngine.Result> rows = new ArrayList<>();
+    float[] distance = new float[1];
+    for (int i = 0; i < Math.min(60, elements.length()); i++) {
+      JSONObject e = elements.getJSONObject(i);
+      JSONObject tags = e.optJSONObject("tags");
+      JSONObject pos = "node".equals(e.optString("type")) ? e : e.optJSONObject("center");
+      if (tags == null || pos == null || !e.has("id")) continue;
+      if (type >= 0 && !AiIntent.TYPES[type][2].equals(tags.optString(AiIntent.TYPES[type][1]))) continue;
+      String name = tags.optString("name:ja", tags.optString("name")).trim();
+      double lat = pos.optDouble("lat"), lon = pos.optDouble("lon");
+      if (name.isEmpty() || name.length() > 160 || !(lat >= 40 && lat <= 46 && lon >= 139 && lon <= 147)) continue;
+      Location.distanceBetween(fix.getLatitude(), fix.getLongitude(), lat, lon, distance);
+      if (distance[0] > intent.radius) continue;
+      double score = Cb6SearchEngine.score(Cb6SearchEngine.normalize(intent.term), name);
+      if (type >= 0) {
+        // Exact brand requests should not return every neighbouring convenience store.
+        if (type == 0 && !AiIntent.matchesBrand(intent.term, name + " " + tags.optString("brand"))) continue;
+        score = Math.max(score, 60);
+      }
+      rows.add(new Cb6SearchEngine.Result(e.getLong("id"), e.getString("type"), name,
+          tags.optString("addr:full"), lat, lon, score));
+    }
+    return rows;
+  }
+
+  static boolean exhausted(JSONObject envelope) {
+    JSONArray errors = envelope.optJSONArray("errors");
+    if (errors == null) return false;
+    for (int i = 0; i < errors.length(); ++i) {
+      JSONObject error = errors.optJSONObject(i);
+      if (error != null && (error.optInt("code") == 4006 ||
+          error.optString("message").toLowerCase(Locale.ROOT).contains("used up your daily free allocation"))) return true;
+    }
+    return false;
+  }
+
+  private JSONObject request(Diagnostic diagnostic, long ticket, String url, String token, String contentType, String body) throws Exception {
+    HttpsURLConnection c = (HttpsURLConnection)new URL(url).openConnection();
+    synchronized (this) { check(ticket); if (!onlineAvailable()) throw new IOException(); active = c; }
+    try {
+      c.setInstanceFollowRedirects(false);
+      c.setUseCaches(false);
+      c.setRequestProperty("Connection", "close");
+      c.setConnectTimeout(5000);
+      c.setReadTimeout(12000);
+      c.setRequestProperty("User-Agent", "CB6-Navi/1.0 (https://github.com/kan1975-creator/CB6-Navi-Public-Build)");
+      if (token != null) c.setRequestProperty("Authorization", "Bearer " + token);
+      if (body != null) {
+        c.setRequestMethod("POST");
+        c.setDoOutput(true);
+        c.setRequestProperty("Content-Type", contentType);
+        byte[] bytes = body.getBytes(StandardCharsets.UTF_8);
+        c.setFixedLengthStreamingMode(bytes.length);
+        try (OutputStream output = c.getOutputStream()) { output.write(bytes); }
+      }
+      int http = c.getResponseCode();
+      diagnostic.http = http;
+      try (InputStream in = http == 200 ? c.getInputStream() : c.getErrorStream(); ByteArrayOutputStream out = new ByteArrayOutputStream()) {
+        if (in == null) throw new IOException();
+        byte[] buffer = new byte[4096];
+        for (int n; (n = in.read(buffer)) != -1;) {
+          check(ticket);
+          if (out.size() + n > 262144) throw new IOException();
+          out.write(buffer, 0, n);
+        }
+        if (http == 200 && diagnostic.stage == Stage.CLASSIFY) diagnostic.stage = Stage.PARSE;
+        JSONObject json = new JSONObject(out.toString("UTF-8"));
+        if (url.contains("/ai/run/") && exhausted(json)) {
+          diagnostic.stage = Stage.QUOTA;
+          long seconds = 0;
+          try { seconds = Long.parseLong(c.getHeaderField("Retry-After")); }
+          catch (NumberFormatException ignored) { }
+          settings.blockUntilReset(c.getDate(), seconds, c.getHeaderFieldDate("Retry-After", 0));
+          throw new IOException();
+        }
+        if (http != 200) throw new IOException();
+        return json;
+      }
+    } finally {
+      c.disconnect();
+      synchronized (this) { if (active == c) active = null; }
+    }
+  }
+}
