diff --git a/android/app/src/main/java/jp/cb6/search/AiIntent.java b/android/app/src/main/java/jp/cb6/search/AiIntent.java
new file mode 100644
index 0000000000000000000000000000000000000000..bde38c5d75af6db4f87967479e73ac23d341c6a7
--- /dev/null
+++ b/android/app/src/main/java/jp/cb6/search/AiIntent.java
@@ -0,0 +1,64 @@
+package jp.cb6.search;
+
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+final class AiIntent {
+  // Only these OSM keys and values can enter a query. Remote output is an index only.
+  static final String[][] TYPES = {
+    {"コンビニ","shop","convenience","コンビニ|セブン|ローソン|ファミマ|ファミリーマート|セコマ|セイコーマート|ミニストップ"},
+    {"ガソリンスタンド","amenity","fuel","ガソリン|給油|スタンド"},
+    {"駐車場","amenity","parking","駐車|パーキング"},
+    {"スーパー","shop","supermarket","スーパー|食料品"},
+    {"トイレ","amenity","toilets","トイレ|お手洗い"},
+    {"病院","amenity","hospital","病院|総合病院"},
+    {"薬局","amenity","pharmacy","薬局|調剤"},
+    {"レストラン","amenity","restaurant","レストラン|食事|飲食"},
+    {"カフェ","amenity","cafe","カフェ|喫茶|コーヒー"}
+  };
+  private static final String[][] BRANDS = {
+    {"セブン", "7-eleven", "7eleven"}, {"ローソン", "lawson"},
+    {"ファミマ", "ファミリーマート", "familymart"},
+    {"セコマ", "セイコーマート", "seicomart"}, {"ミニストップ", "ministop"}
+  };
+  static boolean matchesBrand(String request, String candidate) {
+    String q = Cb6SearchEngine.normalize(request);
+    String name = Cb6SearchEngine.normalize(candidate);
+    for (String[] aliases : BRANDS) {
+      boolean requested = false, matched = false;
+      for (String alias : aliases) {
+        String key = Cb6SearchEngine.normalize(alias);
+        requested |= q.contains(key);
+        matched |= name.contains(key);
+      }
+      if (requested) return matched;
+    }
+    return true;
+  }
+
+  final String term;
+  final int category, radius;
+  private static final Pattern RANGE = Pattern.compile("([0-9]+(?:[.][0-9]+)?)\\s*(km|キロ(?:メートル)?|m|メートル)", Pattern.CASE_INSENSITIVE);
+
+  AiIntent(String query) {
+
+    String clean = java.text.Normalizer.normalize(query, java.text.Normalizer.Form.NFKC);
+    Matcher range = RANGE.matcher(clean);
+    int metres = 3000;
+    if (range.find()) {
+      double factor = range.group(2).toLowerCase(Locale.ROOT).startsWith("k") || range.group(2).startsWith("キロ") ? 1000 : 1;
+      metres = (int)Math.max(50, Math.min(10000, Double.parseDouble(range.group(1)) * factor));
+      clean = range.replaceFirst("");
+    }
+    radius = metres;
+    int found = -1;
+    for (int i = 0; i < TYPES.length; i++) {
+      if (Pattern.compile(TYPES[i][3]).matcher(clean).find()) { found = i; break; }
+    }
+    category = found;
+    clean = clean.replaceAll("現在地周辺|現在地|この辺り|この辺|ここから|近く(?:にある|の)?|付近(?:の)?|周辺(?:の)?|最寄り(?:の)?|一番近い|半径|以内|を探して(?:ください)?|を検索して|を教えて(?:ください)?", "")
+        .replaceAll("^(?:にある|の)\\s*|[\\s？?。]+$", "").trim();
+    term = clean.isEmpty() ? (found >= 0 ? TYPES[found][0] : query) : clean;
+  }
+}
diff --git a/android/app/src/main/java/jp/cb6/search/AiPreferences.java b/android/app/src/main/java/jp/cb6/search/AiPreferences.java
new file mode 100644
index 0000000000000000000000000000000000000000..14b04823f151b5d82e50835841ce1b21db863491
--- /dev/null
+++ b/android/app/src/main/java/jp/cb6/search/AiPreferences.java
@@ -0,0 +1,174 @@
+package jp.cb6.search;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.security.keystore.KeyGenParameterSpec;
+import android.security.keystore.KeyProperties;
+import android.util.Base64;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.security.GeneralSecurityException;
+import java.security.KeyStore;
+import javax.crypto.Cipher;
+import javax.crypto.KeyGenerator;
+import javax.crypto.SecretKey;
+import javax.crypto.spec.GCMParameterSpec;
+import org.json.JSONObject;
+
+final class AiPreferences {
+  private static final String ALIAS = "jp.cb6.search.google.gemma4.v1";
+  private static final String FREE_TERMS = "gemma-4-26b-a4b-it/no-billing/v1";
+  private static long processDeadline;
+  // In-flight requests from a previous registration cannot update the new record.
+  static long registrationGeneration;
+  final SharedPreferences prefs;
+
+  AiPreferences(Context context) {
+    prefs = context.getSharedPreferences("cb6_ai_search_google_gemma4_v1", Context.MODE_PRIVATE);
+  }
+
+  private static synchronized SecretKey key(boolean create) throws Exception {
+    KeyStore store = KeyStore.getInstance("AndroidKeyStore");
+    store.load(null);
+    if (store.containsAlias(ALIAS)) return (SecretKey) store.getKey(ALIAS, null);
+    if (!create) throw new GeneralSecurityException();
+    KeyGenerator generator = KeyGenerator.getInstance("AES", "AndroidKeyStore");
+    generator.init(new KeyGenParameterSpec.Builder(ALIAS,
+        KeyProperties.PURPOSE_ENCRYPT | KeyProperties.PURPOSE_DECRYPT)
+        .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
+        .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE).build());
+    return generator.generateKey();
+  }
+
+  void save(String apiKey, boolean confirmed) throws Exception {
+    if (!confirmed || !apiKey.matches("[A-Za-z0-9._~-]{16,512}"))
+      throw new IllegalArgumentException();
+    Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
+    cipher.init(Cipher.ENCRYPT_MODE, key(true));
+    byte[] clear = new JSONObject().put("freeTerms", FREE_TERMS).put("apiKey", apiKey)
+        .toString().getBytes(StandardCharsets.UTF_8);
+    String envelope = Base64.encodeToString(cipher.getIV(), Base64.NO_WRAP) + "." +
+        Base64.encodeToString(cipher.doFinal(clear), Base64.NO_WRAP);
+    synchronized (AiPreferences.class) {
+      SharedPreferences.Editor editor = prefs.edit().putString("credentials", envelope);
+      boolean sameKey = false;
+      if (prefs.contains("credentials")) {
+        try { sameKey = apiKey.equals(confirmedKey()); } catch (Exception ignored) { }
+      }
+      if (!sameKey) {
+        ++registrationGeneration;
+        clearHistory(editor);
+      }
+      if (!editor.commit()) throw new IOException();
+    }
+  }
+
+  private static SharedPreferences.Editor clearHistory(SharedPreferences.Editor editor) {
+    return editor.remove("lastGoogleResult").remove("lastGoogleAt").remove("googleAuth");
+  }
+
+  void unregister() {
+    synchronized (AiPreferences.class) {
+      ++registrationGeneration;
+      clearHistory(prefs.edit().remove("credentials")).apply();
+    }
+  }
+
+  private static final class TermsUnconfirmed extends GeneralSecurityException { }
+
+  String confirmedKey() throws Exception {
+    String[] fields = prefs.getString("credentials", "").split("[.]", -1);
+    if (fields.length != 2) throw new GeneralSecurityException();
+    Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
+    cipher.init(Cipher.DECRYPT_MODE, key(false), new GCMParameterSpec(128, Base64.decode(fields[0], 0)));
+    JSONObject record = new JSONObject(new String(cipher.doFinal(Base64.decode(fields[1], 0)), StandardCharsets.UTF_8));
+    if (!FREE_TERMS.equals(record.opt("freeTerms"))) throw new TermsUnconfirmed();
+    String apiKey = record.getString("apiKey");
+    if (!apiKey.matches("[A-Za-z0-9._~-]{16,512}")) throw new GeneralSecurityException();
+    return apiKey;
+  }
+
+  String statusText() {
+    synchronized (AiPreferences.class) {
+      boolean registered = prefs.contains("credentials");
+      String encryption = "対象外";
+      String terms = "記録なし";
+      if (registered) {
+        try {
+          confirmedKey();
+          encryption = "正常（復号確認済み）";
+          terms = "本人確認の記録あり";
+        } catch (TermsUnconfirmed ignored) {
+          encryption = "正常（復号確認済み）";
+          terms = "現行条件の記録なし";
+        } catch (Exception ignored) {
+          encryption = "確認不能";
+          terms = "確認不能";
+        }
+      }
+      long time = registered ? prefs.getLong("lastGoogleAt", 0L) : 0L;
+      String date = time == 0L ? "記録なし" :
+          java.text.DateFormat.getDateTimeInstance().format(new java.util.Date(time));
+      return "APIキー登録：" + (registered ? "登録済み" : "未登録")
+          + "\n暗号化：" + encryption + "\n無料条件：" + terms
+          + "\nAPI認証（直近の判定）：" + (registered ? prefs.getString("googleAuth", "未確認") : "未確認")
+          + "\n最終Google通信：" + (registered ? prefs.getString("lastGoogleResult", "記録なし") : "記録なし")
+          + "\n通信日時：" + date;
+    }
+  }
+
+  void recordGoogle(long generation, int http, boolean parsed) {
+    synchronized (AiPreferences.class) {
+      if (generation != registrationGeneration || !prefs.contains("credentials")) return;
+      SharedPreferences.Editor editor = prefs.edit();
+      String result;
+      if (http == 200) {
+        editor.putString("googleAuth", "認証成功");
+        result = parsed ? "分類成功" : "応答読取・解析失敗";
+      } else if (http == 401 || http == 403) {
+        editor.putString("googleAuth", http == 401 ? "認証拒否" : "アクセス拒否（原因未確定）");
+        result = "HTTP " + http;
+      } else if (http == 429) {
+        result = "無料枠停止（HTTP 429）";
+      } else {
+        result = http >= 100 && http <= 599 ? "HTTP " + http : "応答取得不能";
+      }
+      editor.putString("lastGoogleResult", result)
+          .putLong("lastGoogleAt", System.currentTimeMillis()).apply();
+    }
+  }
+
+  boolean quotaBlocked() {
+    synchronized (AiPreferences.class) {
+      return System.currentTimeMillis() < Math.max(processDeadline, prefs.getLong("freeResetAt", 0L));
+    }
+  }
+
+  void blockUntilReset(long serverTime, long retryAfterSeconds, long retryDate) {
+    long deadline = resetAt(System.currentTimeMillis(), serverTime, retryAfterSeconds, retryDate);
+    synchronized (AiPreferences.class) {
+      processDeadline = Math.max(Math.max(processDeadline, prefs.getLong("freeResetAt", 0L)), deadline);
+      if (!prefs.edit().putLong("freeResetAt", processDeadline).commit())
+        {
+          ++registrationGeneration;
+          clearHistory(prefs.edit().remove("credentials")).commit();
+        }
+    }
+  }
+
+  static long resetAt(long now, long serverTime, long retryAfterSeconds, long retryDate) {
+    long base = serverTime > 0 ? serverTime : now;
+    java.util.Calendar midnight = java.util.Calendar.getInstance(java.util.TimeZone.getTimeZone("America/Los_Angeles"));
+    midnight.setTimeInMillis(base);
+    midnight.add(java.util.Calendar.DAY_OF_MONTH, 1);
+    midnight.set(java.util.Calendar.HOUR_OF_DAY, 0);
+    midnight.set(java.util.Calendar.MINUTE, 0);
+    midnight.set(java.util.Calendar.SECOND, 0);
+    midnight.set(java.util.Calendar.MILLISECOND, 0);
+    long midnightDelay = midnight.getTimeInMillis() - base;
+    long delay = Math.max(midnightDelay, retryDate > base ? retryDate - base : 0);
+    if (retryAfterSeconds > 0 && retryAfterSeconds <= (Long.MAX_VALUE - now) / 1000)
+      delay = Math.max(delay, retryAfterSeconds * 1000);
+    return now + Math.min(delay, Long.MAX_VALUE - now);
+  }
+}
