+location::GpsInfo RoutingManager::MatchFreeDriveFix(location::GpsInfo const & info)
+{
+  // Work on real GPS samples. Never share road-graph caches with the route-building thread.
+  bool const freeDrive = !IsRoutingActive() || (m_routingSession.IsNoFollowing() && !IsRoutingFollowing() &&
+                                                m_currentRouterType == RouterType::Vehicle);
+  auto const previous = m_previousFreeDriveFix;
+  m_previousFreeDriveFix = freeDrive ? info : location::GpsInfo{};
+  bool const recent = previous.IsValid() && info.m_timestamp > previous.m_timestamp &&
+                      info.m_timestamp - previous.m_timestamp <= 5.0;
+  bool const reliable = info.m_horizontalAccuracy > 0.0 && info.m_horizontalAccuracy <= 30.0;
+  if (!freeDrive || !info.IsValid() || !recent || !reliable || (info.HasSpeed() && info.m_speed <= 0.5))
+  {
+    m_previousFreeDriveRoad = {};
+    return info;
+  }
+
+  auto const point = mercator::FromLatLon(info.m_latitude, info.m_longitude);
+  auto const prevPoint = mercator::FromLatLon(previous.m_latitude, previous.m_longitude);
+  auto direction = point - prevPoint;
+  if (info.HasBearing() && info.HasSpeed() && info.m_speed > 0.7)
+  {
+    double const radians = math::DegToRad(info.m_bearing);
+    direction = {std::sin(radians), std::cos(radians)};
+  }
+  else if (mercator::DistanceOnEarth(prevPoint, point) < 3.0)
+  {
+    m_previousFreeDriveRoad = {};
+    return info;
+  }
+
+  if (!m_freeDriveCarModel)
+    m_freeDriveCarModel = make_shared<CarModelFactory>(m_callbacks.m_countryParentNameGetterFn);
+  MwmDataSource source(m_callbacks.m_dataSourceGetter(), nullptr);
+  FeaturesRoadGraphBase graph(source, IRoadGraph::Mode::ObeyOnewayTag, m_freeDriveCarModel);
+  EdgeProj projection;
+  auto displayFix = info;
+  double const radius = std::clamp(info.m_horizontalAccuracy, 6.0, 20.0);
+  if (IndexRouter::FindClosestProjectionToRoad(graph, point, direction, radius, projection) &&
+      mercator::DistanceOnEarth(point, projection.m_point) <= radius)
+  {
+    auto const road = projection.m_edge.GetFeatureId();
+    if (road == m_previousFreeDriveRoad)
+    {
+      displayFix.m_latitude = mercator::YToLat(projection.m_point.y);
+      displayFix.m_longitude = mercator::XToLon(projection.m_point.x);
+    }
+    m_previousFreeDriveRoad = road;
+  }
+  else
+  {
+    m_previousFreeDriveRoad = {};
+  }
+  return displayFix;
 }
 
