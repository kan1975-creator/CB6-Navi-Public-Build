--- /dev/null
+++ b/android/app/src/main/java/app/organicmaps/search/Cb6SearchRows.java
@@ -0,0 +1,132 @@
+package app.organicmaps.search;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.Intent;
+import android.location.Location;
+import android.widget.TextView;
+import androidx.recyclerview.widget.RecyclerView;
+import app.organicmaps.MwmActivity;
+import app.organicmaps.sdk.bookmarks.data.FeatureId;
+import app.organicmaps.sdk.bookmarks.data.MapObject;
+import app.organicmaps.sdk.routing.RoutingController;
+import app.organicmaps.sdk.search.SearchResult;
+import jp.cb6.search.Cb6SearchEngine;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/** Display indices are independent of JNI result indices. */
+public final class Cb6SearchRows {
+  static final int CUSTOM = 16;
+  private static final String DESTINATION = "jp.cb6.search.SELECT_DESTINATION";
+  static final class Row {
+    final int nativeIndex;
+    final Cb6SearchEngine.Result result;
+    double score;
+    Row(int index, Cb6SearchEngine.Result r, double value) {
+      nativeIndex = index;
+      result = r;
+      score = value;
+    }
+  }
+
+  static List<Row> merge(String query, SearchResult[] nativeRows, List<Cb6SearchEngine.Result> custom) {
+    List<Row> rows = new ArrayList<>();
+    String q = Cb6SearchEngine.normalize(query);
+    for (int i = 0; i < nativeRows.length; i++) {
+      SearchResult n = nativeRows[i];
+      double score = 0;
+      if (!custom.isEmpty()) {
+        score = n.type == SearchResult.TYPE_RESULT
+            ? Math.max(Cb6SearchEngine.score(q, n.name), Cb6SearchEngine.score(q, n.description.region))
+            : 101; // Native query completions remain above places, in their original order.
+      }
+      rows.add(new Row(i, null, score));
+    }
+    for (Cb6SearchEngine.Result r : custom) {
+      boolean duplicate = false;
+      for (Row row : rows) {
+        if (row.result != null) {
+          if (!row.result.hasPosition() || !same(r, row.result.name, row.result.lat, row.result.lon)) continue;
+        } else {
+          SearchResult n = nativeRows[row.nativeIndex];
+          if (n.type != SearchResult.TYPE_RESULT || !same(r, n.name, n.lat, n.lon)) continue;
+        }
+        row.score = Math.max(row.score, r.score);
+        duplicate = true;
+        break;
+      }
+      if (!duplicate) rows.add(new Row(-1, r, r.score));
+    }
+    if (!custom.isEmpty()) Collections.sort(rows, (a,b) -> Double.compare(b.score, a.score));
+    return rows;
+  }
+
+  private static boolean same(Cb6SearchEngine.Result r, String name, double lat, double lon) {
+    if (!r.hasPosition() || !Double.isFinite(lat) || !Double.isFinite(lon)) return false;
+    String normalized = Cb6SearchEngine.normalize(name);
+    if (normalized.isEmpty() || !normalized.equals(Cb6SearchEngine.normalize(r.name))) return false;
+    float[] distance = new float[1];
+    Location.distanceBetween(r.lat, r.lon, lat, lon, distance);
+    return distance[0] <= 15;
+  }
+
+  static final class Holder extends RecyclerView.ViewHolder {
+    final TextView text;
+    Holder(TextView v) {
+      super(v);
+      text = v;
+      int pad = (int)(16 * v.getResources().getDisplayMetrics().density);
+      v.setPadding(pad, pad, pad, pad);
+      v.setTextSize(16);
+      v.setLayoutParams(new RecyclerView.LayoutParams(-1, -2));
+    }
+    void bind(SearchFragment host, Cb6SearchEngine.Result r) {
+      String label = r.name + "\n" + r.address + "\n" + r.source +
+          (r.hasPosition() ? ("place_point_bbox_only".equals(r.precision) ? " ／ 施設代表点" : " ／ " + r.precision) : " ／ 座標なし");
+      text.setText(label);
+      text.setOnClickListener(v -> {
+        if (!host.isAdded()) return;
+        AlertDialog.Builder dialog = new AlertDialog.Builder(host.requireContext())
+            .setTitle(r.name).setMessage(label).setNegativeButton("閉じる", null);
+        if (r.hasPosition()) dialog.setPositiveButton(RoutingController.get().isWaitingPoiPick() ? "地点を選択" : "目的地に設定",
+            (d,w) -> {
+              if (!host.isAdded()) return;
+              Activity activity = host.requireActivity();
+              if (activity instanceof MwmActivity map) select(map, r.name, r.address, r.lat, r.lon);
+              else {
+                Intent intent = new Intent(activity, MwmActivity.class).setAction(DESTINATION)
+                    .putExtra("name", r.name).putExtra("address", r.address)
+                    .putExtra("lat", r.lat.doubleValue()).putExtra("lon", r.lon.doubleValue());
+                activity.startActivity(intent);
+                activity.finish();
+              }
+            });
+        dialog.show();
+      });
+    }
+  }
+
+  /** MwmActivity can be stopped while the standalone search activity is visible. */
+  public static boolean isDestination(Intent intent) {
+    return intent != null && DESTINATION.equals(intent.getAction());
+  }
+
+  public static void consume(MwmActivity map) {
+    Intent intent = map.getIntent();
+    if (!isDestination(intent)) return;
+    intent.setAction(null);
+    double lat = intent.getDoubleExtra("lat", Double.NaN);
+    double lon = intent.getDoubleExtra("lon", Double.NaN);
+    String name = intent.getStringExtra("name");
+    if (name != null && lat >= 40 && lat <= 46 && lon >= 139 && lon <= 147)
+      select(map, name, intent.getStringExtra("address"), lat, lon);
+  }
+
+  private static void select(MwmActivity map, String name, String address, double lat, double lon) {
+    MapObject point = MapObject.createMapObject(FeatureId.EMPTY, MapObject.SEARCH, name, address, lat, lon);
+    if (RoutingController.get().isWaitingPoiPick()) RoutingController.get().onPoiSelected(point);
+    else map.startLocationToPoint(point);
+  }
+}
