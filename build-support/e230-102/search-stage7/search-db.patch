+package jp.cb6.search;
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+import android.os.Handler;
+import android.os.Looper;
+import java.io.File;
+import java.text.Normalizer;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.AtomicLong;
+
+/** Read-only Stage2 records/grams adapter. Host retains its native search. */
+public final class Cb6SearchEngine implements AutoCloseable {
+ public interface Callback { void done(List<Result> results, Exception error); }
+ public static final class Result {
+  public final long id; public final String source,name,address,precision,level,provenance; public final Double lat,lon; public final double score;
+  Result(Cursor c,double s){id=c.getLong(0);source=c.getString(1);level=c.getString(2);name=c.getString(3);address=c.getString(6);lat=c.isNull(7)?null:c.getDouble(7);lon=c.isNull(8)?null:c.getDouble(8);precision=c.getString(9);provenance=c.getString(10);score=s;}
+  public boolean hasPosition(){return lat!=null&&lon!=null&&Double.isFinite(lat)&&Double.isFinite(lon)&&lat>=40&&lat<=46&&lon>=139&&lon<=147&&precision!=null&&!precision.equals("unknown")&&!precision.isEmpty();}
+  // Host must explicitly display precision and confirm destination; no automatic routing.
+ }
+ private final File file;
+ private final ExecutorService worker = Executors.newSingleThreadExecutor();
+ private final Handler main = new Handler(Looper.getMainLooper());
+ private final AtomicLong epoch = new AtomicLong();
+ private android.os.CancellationSignal cancellation;
+ private Future<?> pending;
+ private boolean closed;
+
+ public Cb6SearchEngine(File file) { this.file = file; }
+
+ public synchronized void cancel() {
+   epoch.incrementAndGet();
+   if (cancellation != null) cancellation.cancel();
+   if (pending != null) pending.cancel(true);
+ }
+
+ public synchronized void search(String query, Callback callback) {
+   if (closed) throw new IllegalStateException("closed");
+   cancel();
+   long ticket = epoch.get();
+   android.os.CancellationSignal signal = new android.os.CancellationSignal();
+   cancellation = signal;
+   pending = worker.submit(() -> {
+     List<Result> rows = Collections.emptyList();
+     Exception error = null;
+     try { rows = run(query, signal); }
+     catch (android.os.OperationCanceledException ignored) { return; }
+     catch (Exception e) { error = e; }
+     final List<Result> result = rows;
+     final Exception failure = error;
+     main.post(() -> { if (epoch.get() == ticket) callback.done(result, failure); });
+   });
+ }
+
+ @Override public synchronized void close() {
+   closed = true;
+   cancel();
+   worker.shutdownNow();
+ }
+ public static String normalize(String s){StringBuilder b=new StringBuilder();Normalizer.normalize(s==null?"":s,Normalizer.Form.NFKC).toLowerCase(Locale.ROOT).codePoints().forEach(x->{if(Character.isLetterOrDigit(x)||Character.getType(x)==Character.LETTER_NUMBER||Character.getType(x)==Character.OTHER_NUMBER)b.appendCodePoint(x>=0x30a1&&x<=0x30f6?x-96:x);});return b.toString();}
+ static int distance(String a,String b){int[] x=a.codePoints().toArray(),y=b.codePoints().toArray(),r=new int[y.length+1];for(int j=0;j<=y.length;j++)r[j]=j;for(int i=1;i<=x.length;i++){int prev=r[0];r[0]=i;for(int j=1;j<=y.length;j++){int old=r[j];r[j]=Math.min(Math.min(r[j]+1,r[j-1]+1),prev+(x[i-1]==y[j-1]?0:1));prev=old;}}return r[y.length];}
+ public static double score(String q,String v){v=normalize(v);if(v.isEmpty())return 0;if(q.equals(v))return 100;if(v.startsWith(q))return 85;if(v.contains(q))return 75;return 60.0*(1.0-(double)distance(q,v)/Math.max(q.codePointCount(0,q.length()),v.codePointCount(0,v.length())));}
+ private List<Result> run(String query, android.os.CancellationSignal signal) {
+   String q = normalize(query);
+   int[] cp = q.codePoints().toArray();
+   if (cp.length == 0 || cp.length > 128) return Collections.emptyList();
+   Set<String> grams = new LinkedHashSet<>();
+   for (int i = 0; i < cp.length; i++) {
+     grams.add(new String(cp, i, 1));
+     if (i + 1 < cp.length) grams.add(new String(cp, i, 2));
+   }
+   String parameters = String.join(",", Collections.nCopies(grams.size(), "?"));
+   String sql = "SELECT r.id,r.source,r.level,r.name,r.reading,r.aliases,r.address,r.lat,r.lon,r.precision,r.provenance "
+       + "FROM records r JOIN (SELECT id,count(*) n FROM grams WHERE gram IN (" + parameters
+       + ") GROUP BY id ORDER BY n DESC,id LIMIT 3000) g ON r.id=g.id";
+   List<Result> results = new ArrayList<>();
+   try (SQLiteDatabase db = SQLiteDatabase.openDatabase(file.getPath(), null,
+            SQLiteDatabase.OPEN_READONLY | SQLiteDatabase.NO_LOCALIZED_COLLATORS);
+        Cursor c = db.rawQuery(sql, grams.toArray(new String[0]), signal)) {
+     while (c.moveToNext()) {
+       signal.throwIfCanceled();
+       double best = 0;
+       for (int i = 3; i <= 6; i++) best = Math.max(best, score(q, c.getString(i)));
+       if (best >= 35) results.add(new Result(c, best));
+     }
+   }
+   results.sort(Comparator.comparingDouble((Result r) -> -r.score).thenComparingLong(r -> r.id));
+   return new ArrayList<>(results.subList(0, Math.min(30, results.size())));
+ }
+}
