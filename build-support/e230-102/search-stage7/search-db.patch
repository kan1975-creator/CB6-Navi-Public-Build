index 0000000..a1f0674
--- /dev/null
+++ b/android/app/src/main/java/jp/cb6/search/Cb6SearchDb.java
@@ -0,0 +1,123 @@
+package jp.cb6.search;
+
+import android.content.Context;
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+import android.net.Uri;
+import android.system.Os;
+import org.tukaani.xz.XZInputStream;
+import java.io.*;
+import java.net.*;
+import java.security.MessageDigest;
+import java.util.Locale;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/** Search-only distribution. Open readers keep their inode across an atomic replacement. */
+public final class Cb6SearchDb {
+  public static final String DRIVE = "https://drive.google.com/file/d/1w2KIHg1N3pQVQeSx-T90-DKuG9vyQZvk/view";
+  private static final String RELEASE = "https://github.com/kan1975-creator/CB6-Navi-Public-Build/releases/download/cb6-search-v1/cb6_search.";
+  private static final String INITIAL_SHA = "72632e1944250dbdfcb5986fc2c790592d392aa23cf160b22405494223b9ecf3";
+  private static final long INITIAL_SIZE = 760750080L;
+  private static final ExecutorService IO = Executors.newSingleThreadExecutor();
+  private static volatile boolean busy;
+  private static volatile String status = "";
+
+  public static File file(Context c) { return new File(c.getFilesDir(), "cb6_search.sqlite"); }
+  public static boolean busy() { return busy; }
+  public static String status() { return status; }
+
+  public static synchronized void install(Context context, Uri document) {
+    if (busy) return;
+    busy = true;
+    status = "取得を開始しています";
+    Context app = context.getApplicationContext();
+    IO.execute(() -> {
+      File tmp = null;
+      try {
+        File dest = file(app);
+        String expected = document != null ? INITIAL_SHA : releaseSha();
+        long limit = INITIAL_SHA.equals(expected) ? INITIAL_SIZE : 2L * 1024 * 1024 * 1024;
+        if (INITIAL_SHA.equals(expected) && app.getFilesDir().getUsableSpace() < INITIAL_SIZE)
+          throw new IOException("展開先の空き容量が不足しています");
+        tmp = new File(app.getFilesDir(), "cb6_search.sqlite.installing");
+        MessageDigest digest = MessageDigest.getInstance("SHA-256");
+        long size = 0;
+        try (InputStream raw = document == null ? remote("sqlite.xz") : app.getContentResolver().openInputStream(document)) {
+          if (raw == null) throw new IOException("選択ファイルを開けません");
+          try (XZInputStream xz = new XZInputStream(new BufferedInputStream(raw, 65536), 98304);
+               FileOutputStream out = new FileOutputStream(tmp)) {
+            byte[] buffer = new byte[131072];
+            for (int n; (n = xz.read(buffer)) != -1;) {
+              size += n;
+              if (size > limit) throw new IOException("展開サイズが上限を超えました");
+              digest.update(buffer, 0, n);
+              out.write(buffer, 0, n);
+              status = "取得・展開中 " + (size >> 20) + " MiB";
+            }
+            out.getFD().sync();
+          }
+        }
+        StringBuilder hex = new StringBuilder(64);
+        for (byte b : digest.digest()) hex.append(String.format(Locale.ROOT, "%02x", b & 255));
+        if (!expected.contentEquals(hex) || (INITIAL_SHA.equals(expected) && size != INITIAL_SIZE))
+          throw new IOException("SHA-256または展開サイズが一致しません");
+        validate(tmp);
+        Os.rename(tmp.getAbsolutePath(), dest.getAbsolutePath());
+        tmp = null;
+        status = "利用可能・SHA-256照合済み";
+      } catch (Exception e) {
+        status = "取得失敗：" + (e.getLocalizedMessage() == null ? e.getClass().getSimpleName() : e.getLocalizedMessage());
+      } finally {
+        if (tmp != null) tmp.delete();
+        busy = false;
+      }
+    });
+  }
+
+  private static InputStream remote(String suffix) throws IOException {
+    URL url = new URL(RELEASE + suffix);
+    for (int i = 0; i < 6; i++) {
+      HttpURLConnection conn = (HttpURLConnection)url.openConnection();
+      conn.setInstanceFollowRedirects(false);
+      conn.setConnectTimeout(15000);
+      conn.setReadTimeout(60000);
+      try {
+        int code = conn.getResponseCode();
+        if (code == 200) {
+          return new FilterInputStream(conn.getInputStream()) {
+            @Override public void close() throws IOException { try { super.close(); } finally { conn.disconnect(); } }
+          };
+        }
+        if (code < 300 || code >= 400 || conn.getHeaderField("Location") == null)
+          throw new IOException("配信先の応答 HTTP " + code);
+        url = new URL(url, conn.getHeaderField("Location"));
+        if (!"https".equals(url.getProtocol())) throw new IOException("HTTPSが必要です");
+      } catch (IOException e) { conn.disconnect(); throw e; }
+      conn.disconnect();
+    }
+    throw new IOException("リダイレクトが多すぎます");
+  }
+
+  private static String releaseSha() throws IOException {
+    try (InputStream in = remote("sha256"); ByteArrayOutputStream out = new ByteArrayOutputStream()) {
+      int ch;
+      while ((ch = in.read()) != -1) {
+        if (out.size() >= 256) throw new IOException("SHAファイルが大きすぎます");
+        out.write(ch);
+      }
+      String line = out.toString("US-ASCII").trim();
+      if (!line.matches("[0-9a-fA-F]{64}(?:[ \\t]+\\*?cb6_search\\.sqlite)?"))
+        throw new IOException("配信SHAの形式が不正です");
+      return line.substring(0, 64).toLowerCase(Locale.ROOT);
+    }
+  }
+
+  private static void validate(File file) throws IOException {
+    try (SQLiteDatabase db = SQLiteDatabase.openDatabase(file.getPath(), null, SQLiteDatabase.OPEN_READONLY | SQLiteDatabase.NO_LOCALIZED_COLLATORS);
+         Cursor records = db.rawQuery("SELECT id,source,level,name,reading,aliases,address,lat,lon,precision,provenance FROM records LIMIT 1", null);
+         Cursor grams = db.rawQuery("SELECT gram,id FROM grams LIMIT 1", null)) {
+      if (!records.moveToFirst() || !grams.moveToFirst()) throw new IOException("検索テーブルが空です");
+    }
+  }
+}
diff --git a/android/app/src/main/java/jp/cb6/search/Cb6SearchEngine.java b/android/app/src/main/java/jp/cb6/search/Cb6SearchEngine.java
