diff --git a/android/app/src/main/java/jp/cb6/search/RuriSearch.java b/android/app/src/main/java/jp/cb6/search/RuriSearch.java
new file mode 100644
--- /dev/null
+++ b/android/app/src/main/java/jp/cb6/search/RuriSearch.java
@@ -0,0 +1,189 @@
+package jp.cb6.search;
+
+import ai.onnxruntime.*;
+import android.app.ActivityManager;
+import android.content.Context;
+import android.location.Location;
+import android.os.CancellationSignal;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.OperationCanceledException;
+import java.io.*;
+import java.nio.LongBuffer;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** A single background lane also serializes native resource disposal across fragment recreation. */
+public final class RuriSearch implements AutoCloseable {
+  public interface Callback { void done(List<Cb6SearchEngine.Result> rows,String status); }
+  private static final ThreadPoolExecutor worker = new ThreadPoolExecutor(1,1,0,TimeUnit.MILLISECONDS,
+      new LinkedBlockingQueue<>(), task -> new Thread(() -> {
+        android.os.Process.setThreadPriority(android.os.Process.THREAD_PRIORITY_BACKGROUND);
+        task.run();
+      },"CB6 Ruri"));
+  private static final Pattern except = Pattern.compile("^(.+?)(?:以外の|を除く)(.+)$");
+  private final Context app;
+  private final Handler ui = new Handler(Looper.getMainLooper());
+  private long generation;
+  private boolean closed;
+  private CancellationSignal signal;
+  private Future<?> task;
+  private OrtSession.RunOptions running;
+  // Accessed only on the worker.
+  private OrtSession session;
+  private OrtEnvironment env;
+  private RuriCatalog catalog;
+  private long processor;
+
+  public RuriSearch(Context context) { app=context.getApplicationContext(); }
+  private static native long openTokenizer(byte[] model);
+  private static native long[] encode(long pointer,byte[] utf8);
+  private static native void closeTokenizer(long pointer);
+
+  public synchronized void cancel() {
+    generation++;
+    if(signal!=null) signal.cancel();
+    if(running!=null) try { running.setTerminate(true); } catch(OrtException ignored) {}
+    if(task!=null) { task.cancel(false); worker.remove((Runnable)task); }
+    signal=null; task=null;
+  }
+  public synchronized void start(String input,Location origin,Callback callback) {
+    cancel();
+    if(closed) return;
+    final long ticket=generation;
+    final CancellationSignal stop=new CancellationSignal();
+    signal=stop;
+    task=worker.submit(() -> {
+      try {
+        checkMemory();
+        initialize(stop);
+        String phrase=input.replaceFirst("(?:を探してください|を探して|を検索して|を教えてください|を教えて)[。？?]?$","").trim();
+        int negative=-1;
+        Matcher m=except.matcher(phrase);
+        if(m.matches()) {
+          negative=catalog.exact(m.group(1).trim());
+          if(negative<0) {
+            deliver(ticket,callback,Collections.emptyList(),"除外条件を確認できないため候補の追加を保留しました");
+            return;
+          }
+          phrase=m.group(2).trim();
+        }
+        float[] query=embedding(phrase,stop);
+        int category=catalog.exact(phrase);
+        if(category<0 && phrase.length()>=2 && !phrase.matches(".*(?:以外|除|ない|なし|なく|不要|禁止|不可|未満|以上|以内|以下|営業中|限定).*"))
+          category=catalog.best(query,phrase,true);
+        if(category<0) {
+          int suggestion=catalog.best(query,phrase,false);
+          deliver(ticket,callback,Collections.emptyList(),"条件未確認・施設追加を保留。関連分類「"+catalog.labels[suggestion]+"」");
+          return;
+        }
+        List<Cb6SearchEngine.Result> rows=catalog.lookup(Cb6SearchDb.file(app),category,negative,origin,stop);
+        deliver(ticket,callback,rows,"端末内候補 "+rows.size()+"件："+catalog.labels[category]);
+      } catch(OperationCanceledException ignored) {
+      } catch(OutOfMemoryError e) {
+        release();
+        deliver(ticket,callback,Collections.emptyList(),"メモリ不足のため端末内分類を停止しました");
+      } catch(FileNotFoundException e) {
+        deliver(ticket,callback,Collections.emptyList(),"端末内検索の資材または施設DBが見つかりません");
+      } catch(Exception | LinkageError e) {
+        release();
+        deliver(ticket,callback,Collections.emptyList(),"端末内分類を停止しました。資材または端末の状態を確認してください");
+      }
+    });
+  }
+  public static boolean hasConstraint(String input) {
+    return input.matches("(?s).*(?:以外|除[くき外]|ない|なし|なく|不要|禁止|不可|未満|以上|以内|以下|営業中|限定|対応|近く|最寄|半径|徒歩|駐車場付き|無料|有料|喫煙|禁煙|深夜|24時間|２４時間|だけ|のみ).*");
+  }
+  private void deliver(long ticket,Callback cb,List<Cb6SearchEngine.Result> rows,String status) {
+    ui.post(() -> {
+      synchronized(this) { if(closed || generation!=ticket) return; }
+      cb.done(rows,status);
+    });
+  }
+  private void checkMemory() {
+    ActivityManager manager=(ActivityManager)app.getSystemService(Context.ACTIVITY_SERVICE);
+    ActivityManager.MemoryInfo mem=new ActivityManager.MemoryInfo();
+    manager.getMemoryInfo(mem);
+    if(mem.lowMemory || mem.availMem-mem.threshold < (session==null?128L:32L)*1024*1024)
+      throw new OutOfMemoryError();
+  }
+  private void copyVerified(String name, OutputStream out,CancellationSignal stop) throws Exception {
+    MessageDigest sha=MessageDigest.getInstance("SHA-256");
+    try(InputStream raw=app.getAssets().open("cb6_ruri/"+name)) {
+      byte[] buf=new byte[65536];
+      int n;
+      while((n=raw.read(buf))!=-1) {
+        stop.throwIfCanceled(); sha.update(buf,0,n); out.write(buf,0,n);
+      }
+    }
+    StringBuilder hex=new StringBuilder();
+    for(byte b:sha.digest()) hex.append(String.format(Locale.ROOT,"%02x",b&255));
+    if(!hex.toString().equals(RuriHashes.of(name))) throw new IOException("asset integrity");
+  }
+  private byte[] data(String name,CancellationSignal stop) throws Exception {
+    ByteArrayOutputStream bytes=new ByteArrayOutputStream();
+    copyVerified(name,bytes,stop);
+    return bytes.toByteArray();
+  }
+  private void initialize(CancellationSignal stop) throws Exception {
+    stop.throwIfCanceled();
+    if(session!=null) return;
+    try {
+      System.loadLibrary("cb6_ruri_sp");
+      processor=openTokenizer(data("tokenizer.model",stop));
+      catalog=new RuriCatalog(data("categories.tsv",stop),data("categories.f32",stop),data("places.bin",stop));
+      env=OrtEnvironment.getEnvironment();
+      env.setTelemetry(false);
+      File file=File.createTempFile("cb6-ruri-",".onnx",app.getCacheDir());
+      try {
+        try(OutputStream out=new FileOutputStream(file)) { copyVerified("model_int8.onnx",out,stop); }
+        try(OrtSession.SessionOptions options=new OrtSession.SessionOptions()) {
+          options.setIntraOpNumThreads(1);
+          options.setInterOpNumThreads(1);
+          options.setExecutionMode(OrtSession.SessionOptions.ExecutionMode.SEQUENTIAL);
+          options.setCPUArenaAllocator(false);
+          options.setMemoryPatternOptimization(false);
+          stop.throwIfCanceled(); checkMemory();
+          session=env.createSession(file.getPath(),options);
+        }
+      } finally { file.delete(); }
+    } finally { if(session==null) release(); }
+  }
+  private float[] embedding(String phrase,CancellationSignal stop) throws Exception {
+    long[] ids=encode(processor,("検索クエリ: "+phrase).getBytes(StandardCharsets.UTF_8));
+    long[] mask=new long[ids.length]; Arrays.fill(mask,1L);
+    long[] shape={1,ids.length};
+    try(OnnxTensor tokens=OnnxTensor.createTensor(env,LongBuffer.wrap(ids),shape);
+        OnnxTensor attention=OnnxTensor.createTensor(env,LongBuffer.wrap(mask),shape);
+        OrtSession.RunOptions opts=new OrtSession.RunOptions()) {
+      Map<String,OnnxTensor> inputs=new HashMap<>();
+      inputs.put("input_ids",tokens); inputs.put("attention_mask",attention);
+      synchronized(this) { stop.throwIfCanceled(); running=opts; }
+      try(OrtSession.Result result=session.run(inputs,opts)) {
+        float[][][] hidden=(float[][][])result.get(0).getValue();
+        float[] vector=new float[RuriCatalog.DIM];
+        for(float[] token:hidden[0]) for(int k=0;k<vector.length;k++) vector[k]+=token[k];
+        double norm=0;
+        for(int k=0;k<vector.length;k++) { vector[k]/=ids.length; norm+=(double)vector[k]*vector[k]; }
+        if(!Double.isFinite(norm) || norm<=0) throw new IOException("embedding");
+        float scale=(float)(1/Math.sqrt(norm));
+        for(int k=0;k<vector.length;k++) vector[k]*=scale;
+        stop.throwIfCanceled();
+        return vector;
+      } finally { synchronized(this) { running=null; } }
+    }
+  }
+  private void release() {
+    if(session!=null) try { session.close(); } catch(OrtException ignored) {}
+    session=null; catalog=null;
+    if(processor!=0) { closeTokenizer(processor); processor=0; }
+  }
+  @Override public synchronized void close() {
+    if(closed) return;
+    closed=true; cancel(); worker.execute(this::release);
+  }
+}
