diff --git a/android/app/src/main/java/jp/cb6/search/RuriCatalog.java b/android/app/src/main/java/jp/cb6/search/RuriCatalog.java
new file mode 100644
--- /dev/null
+++ b/android/app/src/main/java/jp/cb6/search/RuriCatalog.java
@@ -0,0 +1,127 @@
+package jp.cb6.search;
+
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+import android.location.Location;
+import android.os.CancellationSignal;
+import java.io.File;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.util.*;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+final class RuriCatalog {
+  static final int COUNT = 1083, DIM = 256;
+  final String[] keys = new String[COUNT], labels = new String[COUNT];
+  private final ByteBuffer vectors, places;
+  private static final Map<String,String> terms = new HashMap<>();
+  static {
+    String[][] pairs = {
+      {"コンビニ","convenience_store"},{"コンビニエンスストア","convenience_store"},
+      {"スーパー","grocery_store"},{"ガソリンスタンド","gas_station"},{"給油","gas_station"},
+      {"温泉","onsen"},{"銭湯","public_bath_house"},{"カフェ","cafe"},{"喫茶店","coffee_shop"},
+      {"公園","park"},{"空港","airport"},{"病院","hospital"},{"本屋","bookstore"},
+      {"パン屋","bakery"},{"パンを買いたい","bakery"},{"薬局","pharmacy"},{"宿泊","lodging"},
+      {"食事","restaurant"},{"飲食店","restaurant"},{"レストラン","restaurant"},
+      {"寿司","sushi_restaurant"},{"和食","japanese_restaurant"},{"ラーメン","ramen_restaurant"},
+      {"中華","chinese_restaurant"},{"駐車場","parking"},
+      {"トイレ","public_restroom"},{"映画館","movie_theater"},{"買い物","shopping"},
+      {"ホテル","hotel"},{"宿","lodging"},{"銀行","bank"},{"水族館","aquarium"}
+    };
+    for (String[] p : pairs) terms.put(p[0],p[1]);
+  }
+  RuriCatalog(byte[] text, byte[] weights, byte[] rows) {
+    String[] lines = new String(text, StandardCharsets.UTF_8).split("\n");
+    if (lines.length != COUNT || weights.length != COUNT*DIM*4) throw new IllegalArgumentException();
+    for (int i=0;i<COUNT;i++) {
+      String[] fields=lines[i].split("\t",2);
+      keys[i]=fields[0]; labels[i]=fields[1];
+    }
+    vectors=ByteBuffer.wrap(weights).order(ByteOrder.LITTLE_ENDIAN);
+    places=ByteBuffer.wrap(rows).order(ByteOrder.LITTLE_ENDIAN);
+    if (rows.length != (COUNT+1)*4 + 12L*offset(COUNT)) throw new IllegalArgumentException();
+  }
+  int exact(String value) {
+    String key=terms.getOrDefault(value,value);
+    for (int i=0;i<COUNT;i++) if (keys[i].equals(key) || labels[i].equals(value)) return i;
+    return -1;
+  }
+  int best(float[] query, String literal, boolean requireLiteral) {
+    int best=-1; double high=-Double.MAX_VALUE;
+    for (int i=0;i<COUNT;i++) {
+      if (requireLiteral && !labels[i].contains(literal)) continue;
+      double score=0;
+      for (int k=0;k<DIM;k++) score+=vectors.getFloat((i*DIM+k)*4)*query[k];
+      if (score>high) { high=score; best=i; }
+    }
+    return best;
+  }
+  private int offset(int category) { return places.getInt(category*4); }
+  private int field(int row,int field) { return places.getInt((COUNT+1)*4 + 12*row + 4*field); }
+  private boolean excluded(int category,int id) {
+    if (category<0) return false;
+    int low=offset(category), end=offset(category+1), high=end;
+    while (low<high) {
+      int mid=(low+high)>>>1;
+      if (field(mid,0)<id) low=mid+1; else high=mid;
+    }
+    return low<end && field(low,0)==id;
+  }
+  private static boolean tagged(JSONObject data,String key) {
+    if (key.equals(data.optString("basic_category"))) return true;
+    JSONObject tax=data.optJSONObject("taxonomy");
+    if (tax==null) return false;
+    if (key.equals(tax.optString("primary"))) return true;
+    for (String field:new String[]{"alternates","hierarchy"}) {
+      JSONArray array=tax.optJSONArray(field);
+      if (array!=null) for(int i=0;i<array.length();i++) if(key.equals(array.optString(i))) return true;
+    }
+    return false;
+  }
+  private static final class Hit {
+    final int id;
+    final double distance;
+    Hit(int id,double distance) { this.id=id; this.distance=distance; }
+  }
+  List<Cb6SearchEngine.Result> lookup(File file,int category,int negative,Location fix,
+                                       CancellationSignal stop) throws Exception {
+    if (!file.isFile()) throw new java.io.FileNotFoundException();
+    Comparator<Hit> order=Comparator.comparingDouble((Hit h)->h.distance).thenComparingInt(h->h.id);
+    PriorityQueue<Hit> nearest=new PriorityQueue<>(32,order.reversed());
+    double scale=fix==null?1:Math.cos(Math.toRadians(fix.getLatitude()));
+    for (int i=offset(category);i<offset(category+1);i++) {
+      if ((i&127)==0) stop.throwIfCanceled();
+      int id=field(i,0);
+      if (excluded(negative,id)) continue;
+      double dist=0;
+      if (fix!=null) {
+        double dy=field(i,1)*1e-6-fix.getLatitude();
+        double dx=(field(i,2)*1e-6-fix.getLongitude())*scale;
+        dist=dx*dx+dy*dy;
+      }
+      if (nearest.size()==32 && dist>=nearest.peek().distance) continue;
+      nearest.add(new Hit(id,dist));
+      if(nearest.size()>32) nearest.remove();
+    }
+    List<Hit> sorted=new ArrayList<>(nearest);
+    sorted.sort(order);
+    List<Cb6SearchEngine.Result> output=new ArrayList<>();
+    String sql="SELECT id,source,level,name,reading,aliases,address,lat,lon,precision,provenance "+
+        "FROM records WHERE id=? AND source='Overture' AND level='place'";
+    try(SQLiteDatabase db=SQLiteDatabase.openDatabase(file.getPath(),null,SQLiteDatabase.OPEN_READONLY)) {
+      for (Hit h:sorted) {
+        stop.throwIfCanceled();
+        try(Cursor c=db.rawQuery(sql,new String[]{Integer.toString(h.id)},stop)) {
+          if(!c.moveToFirst()) continue;
+          JSONObject data=new JSONObject(c.getString(10));
+          if(!tagged(data,keys[category]) || (negative>=0 && tagged(data,keys[negative]))) continue;
+          Cb6SearchEngine.Result place=new Cb6SearchEngine.Result(c,45);
+          if(place.hasPosition()) output.add(place);
+        }
+      }
+    }
+    return output;
+  }
+}
