new file mode 100644
--- /dev/null
+++ b/android/sdk/src/main/cpp/cb6_ruri/ruri_sp.cpp
@@ -0,0 +1,54 @@
+#include <jni.h>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#include "sentencepiece_processor.h"
+
+namespace {
+std::string bytes(JNIEnv *env, jbyteArray input) {
+  std::string result(env->GetArrayLength(input), '\0');
+  env->GetByteArrayRegion(input, 0, result.size(), reinterpret_cast<jbyte *>(&result[0]));
+  return result;
+}
+void fail(JNIEnv *env, const char *type) {
+  if (!env->ExceptionCheck()) env->ThrowNew(env->FindClass(type), "SentencePiece");
+}
+}
+extern "C" JNIEXPORT jlong JNICALL
+Java_jp_cb6_search_RuriSearch_openTokenizer(JNIEnv *env, jclass, jbyteArray data) {
+  try {
+    auto p = std::make_unique<sentencepiece::SentencePieceProcessor>();
+    auto model = bytes(env, data);
+    if (env->ExceptionCheck()) return 0;
+    if (!p->LoadFromSerializedProto(model).ok() || p->bos_id()!=1 || p->eos_id()!=2 || p->pad_id()!=3)
+      throw std::runtime_error("model");
+    return reinterpret_cast<jlong>(p.release());
+  } catch (const std::bad_alloc &) { fail(env,"java/lang/OutOfMemoryError"); }
+    catch (...) { fail(env,"java/lang/IllegalStateException"); }
+  return 0;
+}
+extern "C" JNIEXPORT jlongArray JNICALL
+Java_jp_cb6_search_RuriSearch_encode(JNIEnv *env, jclass, jlong handle, jbyteArray data) {
+  try {
+    auto text = bytes(env,data);
+    if (env->ExceptionCheck()) return nullptr;
+    std::vector<int> tokens;
+    auto *p = reinterpret_cast<sentencepiece::SentencePieceProcessor *>(handle);
+    if (!p->Encode(text, &tokens).ok()) throw std::runtime_error("encode");
+    std::vector<jlong> ids;
+    ids.reserve(tokens.size()+2);
+    ids.push_back(1);
+    ids.insert(ids.end(),tokens.begin(),tokens.end());
+    ids.push_back(2);
+    auto result = env->NewLongArray(ids.size());
+    if (result) env->SetLongArrayRegion(result,0,ids.size(),ids.data());
+    return result;
+  } catch (const std::bad_alloc &) { fail(env,"java/lang/OutOfMemoryError"); }
+    catch (...) { fail(env,"java/lang/IllegalStateException"); }
+  return nullptr;
+}
+extern "C" JNIEXPORT void JNICALL
+Java_jp_cb6_search_RuriSearch_closeTokenizer(JNIEnv *, jclass, jlong handle) {
+  delete reinterpret_cast<sentencepiece::SentencePieceProcessor *>(handle);
+}
