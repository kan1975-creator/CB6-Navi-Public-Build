{
  "schema": 1,
  "policy_id": "cb6-development-monitoring",
  "version": 1,
  "status": "ACTIVE",
  "method_version": 2,
  "cadence_minutes": 60,
  "normal_cycle": [
    "inspect_current_head_and_actions",
    "make_substantive_change",
    "run_relevant_verification",
    "commit_substantive_change"
  ],
  "success_requirement": "Every completed monitoring cycle must record a substantive commit unless exactly one permitted external wait reason applies.",
  "permitted_no_commit_reasons": [
    "ACTIONS_WAIT",
    "DEVICE_EVIDENCE_WAIT",
    "SPEC_DECISION_WAIT",
    "PERMISSION_WAIT"
  ],
  "forbidden_no_commit_reasons": [
    "STATUS_CHECK_ONLY",
    "NO_CHANGE_ATTEMPTED",
    "CHAT_INSTRUCTION_WAIT"
  ],
  "cycle_log": "v2/monitoring/cycles.jsonl",
  "revision_policy": {
    "in_place_change_forbidden": true,
    "new_version_required": true,
    "reason_required": true,
    "independent_reapproval_required": true
  },
  "evidence_rule": "Chat statements are not monitoring evidence. Repository cycle records plus referenced GitHub commit/run or external-wait evidence are authoritative."
}
