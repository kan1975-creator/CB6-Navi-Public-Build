{
  "schema": 7,
  "rule_id": "OPS-STATUS-REPORTING-001",
  "status": "ACTIVE",
  "source": "explicit_user_adoption_2026-10-03_status_reporting_v7",
  "scope": {
    "type": "CB6_PROJECT_WIDE_CROSS_CUTTING",
    "consolidated_worklist": "v2/governance/consolidated_worklist_2026-09-30.md",
    "consolidated_worklist_required_item_count": 33,
    "all_33_items_mandatory": true,
    "applies_to_all_derivative_work": true,
    "applies_to_all_future_work": true,
    "applies_to_unknown_future_features_without_enumeration": true,
    "feature_specific_override_may_weaken_or_disable": false,
    "new_feature_requires_explicit_opt_in": false
  },
  "allowed_classifications": [
    "進めて推奨",
    "待ち",
    "スマホ操作が必要"
  ],
  "exactly_one_classification_required": true,
  "required_report_fields": [
    "分類",
    "次にユーザーがすること",
    "ChatGPTアプリ",
    "スマホ操作"
  ],
  "four_line_template": {
    "required": true,
    "classification_field": "分類",
    "next_user_action_field": "次にユーザーがすること",
    "chatgpt_app_field": "ChatGPTアプリ",
    "smartphone_action_field": "スマホ操作",
    "no_user_operation_form": {
      "分類": "進めて推奨",
      "次にユーザーがすること": "「進めて」",
      "ChatGPTアプリ": "閉じてOK",
      "スマホ操作": "不要。再試行もしなくて大丈夫です。"
    },
    "state_consistency_required": true,
    "placement": "FINAL_FOUR_LINES",
    "final_four_lines_required": true,
    "order_exactly_required": [
      "分類",
      "次にユーザーがすること",
      "ChatGPTアプリ",
      "スマホ操作"
    ],
    "content_after_four_lines_forbidden": true
  },
  "rules": {
    "進めて推奨": {
      "chat_instruction_wait_alone_forbidden": true
    },
    "待ち": {
      "required_fields": [
        "approximate_wait_time",
        "next_check_timing",
        "parallel_work_available",
        "post_wait_user_instruction"
      ],
      "parallel_read_only_work_allowed": true,
      "post_wait_user_instruction": {
        "required": true,
        "when_user_instruction_needed": "state the concrete instruction the user should send after the wait, e.g. 進めて",
        "when_automatic_monitoring_active": "指示不要・自動モニタリング継続"
      },
      "wait_time_display": {
        "run_start_basis": "IMMUTABLE_ORIGINAL_RUN_START",
        "first_wait": {
          "show_run_start_time_jst": true,
          "next_check_basis": "RECENT_ACTUAL_SAME_WORKFLOW_DURATION"
        },
        "later_wait": {
          "show_cumulative_elapsed_from_original_run_start": true,
          "intermediate_check_must_not_reset_basis": true,
          "next_check_is_remaining_interval": true,
          "recalculate_from_original_start_and_recent_actual_duration": true
        },
        "exceeded_normal_duration": {
          "basis": "RECENT_SUCCESSFUL_SAME_WORKFLOW_ACTUAL_DURATIONS",
          "recent_successful_same_workflow_actual_durations_required_when_available": true,
          "fixed_or_unsubstantiated_threshold_forbidden": true,
          "may_classify_exceeded_only_after_evidence_based_normal_duration_range_exceeded": true,
          "use_shorter_reasonable_next_check_interval": true,
          "restart_original_interval_forbidden": true
        },
        "completed_run": {
          "report_completed_result_instead_of_wait": true
        },
        "history": {
          "same_workflow_recent_actual_duration_required_when_available": true,
          "user_check_delay_must_not_distort_duration": true,
          "calculation_detail_normally_hidden": true,
          "show_detail_when_user_asks_basis": true
        }
      }
    },
    "スマホ操作が必要": {
      "required_fields": [
        "required_device_action",
        "required_evidence",
        "final_user_action_section"
      ],
      "final_user_action_section": {
        "required": true,
        "heading": "あなたが今すること",
        "placement": "REPORT_END",
        "concrete_steps_required": true,
        "include_when_known": [
          "target_apk_or_build",
          "operation_target",
          "location_and_zoom_or_equivalent_test_condition",
          "what_to_verify",
          "evidence_to_return"
        ],
        "generic_device_instruction_forbidden": true
      },
      "fail_closed": {
        "required": true,
        "if_concrete_operation_not_identified": "DO_NOT_CLASSIFY_AS_SMARTPHONE_ACTION_REQUIRED",
        "assistant_must_identify_operation_first": true
      }
    }
  },
  "freshness_rule": {
    "progress_query_requires_current_head": true,
    "progress_query_requires_relevant_run": true,
    "material_log_evidence_requires_fresh_raw_log": true,
    "delegates_stale_state_authority_to": "v2/gates/notification_stale_state.json"
  },
  "fix_approval_boundary": {
    "delegates_to": "OPS-USER-APPROVAL-BEFORE-FIX-001"
  },
  "activation": {
    "direct_active_forbidden": false,
    "requires": [
      "positive_verification",
      "destructive_test",
      "successful_github_run_evidence",
      "independent_review",
      "explicit_user_adoption",
      "machine_enforced_coverage"
    ]
  },
  "report_tags": {
    "required_at_report_start": true,
    "allowed": [
      "ガバナンス",
      "信号機",
      "コンビニ",
      "その他"
    ],
    "tag_presence_does_not_replace_status_classification": true
  },
  "revision": {
    "from": "v2/gates/status_reporting_contract_v6.json",
    "reason": "Prevent premature normal-duration-overrun claims by requiring recent successful same-workflow actual durations when available and forbidding fixed or unsupported thresholds; all other v6 rules remain unchanged.",
    "supersedes": "v2/gates/status_reporting_contract_v6.json"
  },
  "adoption": {
    "decision": "Status Reporting v7通常時間超過判定について、Candidate Gate #20 Run 37128623188 と Independent Review #12 Run 37128782100 のSUCCESSをEvidenceとして正式採用し、ACTIVE化・Registry/Coverage反映・既存検証への接続を承認して進めて。v7で追加した通常時間超過判定以外のv6ルール・既存3分類・スマホ操作ルール・その他Governanceは変更しない",
    "adopted_at": "2026-10-03",
    "candidate_validation_run_id": 37128623188,
    "independent_review_run_id": 37128782100,
    "independent_review_head": "b016f9d10b549b3b0dd907c5cf32dffb1c073173",
    "coverage_required": "MACHINE_ENFORCED"
  },
  "final_summary_display": {
    "placement": "REPORT_END",
    "markdown_bullet_and_bold_required": true,
    "duplicate_information_forbidden": true,
    "non_wait_fields": [
      "分類",
      "次にユーザーがすること",
      "ChatGPTアプリ",
      "スマホ操作"
    ],
    "wait_additional_fields": [
      "累積経過時間",
      "次回確認目安"
    ],
    "wait_additional_fields_only_when_classification": "待ち",
    "preserve_v5_wait_time_calculation_rules": true,
    "content_after_final_summary_forbidden": true
  }
}
