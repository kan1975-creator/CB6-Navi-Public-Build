      "proposal": {
        "rule": "An implementation-problem fix commit must be blocked unless explicit user approval for the specific proposed change was obtained before implementation work begins.",
        "github_verification_source": "Commit message or pull-request description must contain a machine-readable approval reference including approval timestamp and concise approved-change summary, canonically bound to the exact proposed change identity.",
