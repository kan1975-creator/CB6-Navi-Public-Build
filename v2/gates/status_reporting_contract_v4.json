{
  "schema": 4,
  "rule_id": "OPS-STATUS-REPORTING-001",
  "status": "ACTIVE",
  "source": "explicit_user_adoption_2026-10-02_status_reporting_v4",
  "scope": {
    "type": "CB6_PROJECT_WIDE_CROSS_CUTTING",
    "consolidated_worklist": "v2/governance/consolidated_worklist_2026-09-30.md",
    "consolidated_worklist_required_item_count": 33,
    "all_33_items_mandatory": true,
    "applies_to_all_derivative_work": true,
    "applies_to_all_future_work": true,
    "applies_to_unknown_future_features_without_enumeration": true,
    "feature_specific_override_may_weaken_or_disable": false,
    "new_feature_requires_explicit_opt_in": false
  },
  "allowed_classifications": [
    "進めて推奨",
    "待ち",
    "スマホ操作が必要"
  ],
  "exactly_one_classification_required": true,
  "required_report_fields": [
    "分類",
    "次にユーザーがすること",
    "ChatGPTアプリ",
    "スマホ操作"
  ],
  "four_line_template": {
    "required": true,
    "classification_field": "分類",
    "next_user_action_field": "次にユーザーがすること",
    "chatgpt_app_field": "ChatGPTアプリ",
    "smartphone_action_field": "スマホ操作",
    "no_user_operation_form": {
      "分類": "進めて推奨",
      "次にユーザーがすること": "「進めて」",
      "ChatGPTアプリ": "閉じてOK",
      "スマホ操作": "不要。再試行もしなくて大丈夫です。"
    },
    "state_consistency_required": true,
    "placement": "FINAL_FOUR_LINES",
    "final_four_lines_required": true,
    "order_exactly_required": [
      "分類",
      "次にユーザーがすること",
      "ChatGPTアプリ",
      "スマホ操作"
    ],
    "content_after_four_lines_forbidden": true
  },
  "rules": {
    "進めて推奨": {
      "chat_instruction_wait_alone_forbidden": true
    },
    "待ち": {
      "required_fields": [
        "approximate_wait_time",
        "next_check_timing",
        "parallel_work_available",
        "post_wait_user_instruction"
      ],
      "parallel_read_only_work_allowed": true,
      "post_wait_user_instruction": {
        "required": true,
        "when_user_instruction_needed": "state the concrete instruction the user should send after the wait, e.g. 進めて",
        "when_automatic_monitoring_active": "指示不要・自動モニタリング継続"
      }
    },
    "スマホ操作が必要": {
      "required_fields": [
        "required_device_action",
        "required_evidence",
        "final_user_action_section"
      ],
      "final_user_action_section": {
        "required": true,
        "heading": "あなたが今すること",
        "placement": "REPORT_END",
        "concrete_steps_required": true,
        "include_when_known": [
          "target_apk_or_build",
          "operation_target",
          "location_and_zoom_or_equivalent_test_condition",
          "what_to_verify",
          "evidence_to_return"
        ],
        "generic_device_instruction_forbidden": true
      },
      "fail_closed": {
        "required": true,
        "if_concrete_operation_not_identified": "DO_NOT_CLASSIFY_AS_SMARTPHONE_ACTION_REQUIRED",
        "assistant_must_identify_operation_first": true
      }
    }
  },
  "freshness_rule": {
    "progress_query_requires_current_head": true,
    "progress_query_requires_relevant_run": true,
    "material_log_evidence_requires_fresh_raw_log": true,
    "delegates_stale_state_authority_to": "v2/gates/notification_stale_state.json"
  },
  "fix_approval_boundary": {
    "delegates_to": "OPS-USER-APPROVAL-BEFORE-FIX-001"
  },
  "activation": {
    "direct_active_forbidden": false,
    "requires": [
      "positive_verification",
      "destructive_test",
      "successful_github_run_evidence",
      "independent_review",
      "explicit_user_adoption",
      "machine_enforced_coverage"
    ]
  },
  "report_tags": {
    "required_at_report_start": true,
    "allowed": [
      "ガバナンス",
      "信号機",
      "コンビニ",
      "その他"
    ],
    "tag_presence_does_not_replace_status_classification": true
  },
  "revision": {
    "from": "v2/gates/status_reporting_contract_v3.json",
    "reason": "Add the approved mandatory concrete smartphone-action section and fail-closed unidentified-operation rule, plus require the four status lines to be the final four lines of every CB6 progress report; ACTIVE v3 remains unchanged until lifecycle completion.",
    "supersedes": "v2/gates/status_reporting_contract_v3.json"
  },
  "adoption": {
    "decision": "v4を正式採用して進めて",
    "adopted_at": "2026-10-02",
    "candidate_validation_run_id": 36988836384,
    "independent_review_run_id": 36996374433,
    "independent_review_head": "57a834424005c15f45935cfc2a52fc1ed6935938",
    "coverage_required": "MACHINE_ENFORCED"
  }
}
