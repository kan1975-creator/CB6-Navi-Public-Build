{
  "schema": 1,
  "policy_id": "notification-stale-state",
  "method_version": 2,
  "authority": "repository_current_state",
  "notification_is_authority": false,
  "states": [
    "CURRENT",
    "RESYNC_REQUIRED",
    "RESOLVED",
    "USER_DECISION_REQUIRED"
  ],
  "rules": {
    "stale_commit_or_run_must_not_resume": true,
    "stale_must_resync_to_current_head_and_run": true,
    "resolved_after_resync_must_not_ask_user": true,
    "unresolved_after_resync_must_present_current_state_and_request_decision": true
  }
}
