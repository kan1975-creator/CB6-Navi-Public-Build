{
  "schema": 1,
  "rule_id": "OPS-STATUS-REPORTING-001",
  "status": "CANDIDATE",
  "source": "explicit_user_continuing_instruction_2026-09-30",
  "allowed_classifications": ["進めて推奨", "待ち", "スマホ操作が必要"],
  "exactly_one_classification_required": true,
  "rules": {
    "進めて推奨": {
      "meaning": "Safe assistant/GitHub-side work can continue.",
      "chat_instruction_wait_alone_forbidden": true
    },
    "待ち": {
      "meaning": "Blocked on an external result.",
      "required_fields": ["approximate_wait_time", "next_check_timing", "parallel_work_available"],
      "parallel_read_only_work_allowed": true
    },
    "スマホ操作が必要": {
      "meaning": "Physical CB6/device action or evidence is required for the next step.",
      "required_fields": ["required_device_action", "required_evidence"]
    }
  },
  "freshness_rule": {
    "progress_query_requires_current_head": true,
    "progress_query_requires_relevant_run": true,
    "material_log_evidence_requires_fresh_raw_log": true,
    "delegates_stale_state_authority_to": "v2/gates/notification_stale_state.json"
  },
  "fix_approval_boundary": {
    "delegates_to": "OPS-USER-APPROVAL-BEFORE-FIX-001",
    "generic_progress_permission_is_not_specific_fix_approval": true
  },
  "activation": {
    "direct_active_forbidden": true,
    "requires": ["positive_verification","destructive_test","successful_github_run_evidence","independent_review","explicit_user_adoption","machine_enforced_coverage"]
  }
}
